<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Your Day in History</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    html { scroll-behavior: smooth; }
    .tab-scroll::-webkit-scrollbar { height: 6px; }
    .tab-scroll::-webkit-scrollbar-thumb { background: rgba(168,85,247,.5); border-radius: 9999px; }
    .tab-scroll::-webkit-scrollbar-track { background: transparent; }
    @keyframes fadeUp {
      from { opacity: 0; transform: translateY(12px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .card-enter { animation: fadeUp .4s ease both; }
    .gradient-text {
      background: linear-gradient(90deg, #c084fc, #818cf8, #22d3ee);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
  </style>
</head>

<body class="bg-gradient-to-br from-indigo-900 via-purple-900 to-black text-white min-h-screen antialiased">

  <!-- Loader -->
  <div id="loader" class="fixed inset-0 bg-black/80 backdrop-blur-sm flex flex-col items-center justify-center z-50 hidden">
    <div class="w-16 h-16 border-4 border-purple-400 border-t-transparent rounded-full animate-spin"></div>
    <p class="mt-4 text-lg text-gray-300 animate-pulse">Fetching...</p>
  </div>

  <!-- Header -->
  <header class="pt-10 pb-6 px-4 text-center">
    <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight gradient-text">
      📜 Your Day in History
    </h1>
    <p class="mt-3 text-sm sm:text-base md:text-lg text-gray-300 max-w-2xl mx-auto">
      Discover historical events, famous births, and more from your birthday.
    </p>
  </header>

  <!-- Form -->
  <section class="max-w-xl mx-auto px-4">
    <div class="bg-white/10 backdrop-blur-lg p-5 sm:p-6 rounded-2xl shadow-2xl ring-1 ring-white/10">
      <form method="post" action="/getData" class="flex flex-col md:flex-row gap-3 sm:gap-4" onsubmit="showLoader()">
        <input type="date" name="date" required
          onclick="this.showPicker && this.showPicker()"
          class="flex-1 w-full px-4 py-3 rounded-xl bg-gray-800/80 text-white placeholder-gray-400 border border-gray-700 focus:outline-none focus:ring-4 focus:ring-purple-500/50 transition" />
        <button type="submit"
          class="w-full md:w-auto px-6 py-3 bg-gradient-to-r from-purple-500 to-indigo-500 rounded-xl font-semibold hover:scale-[1.03] active:scale-95 transition transform shadow-lg shadow-purple-900/40">
          Show History
        </button>
      </form>
    </div>
  </section>

  <!-- Results -->
  <% if (data) { %>
    
  <section class="max-w-6xl mx-auto mt-10 px-4 pb-16">

    <!-- DOB Badge -->
    <div class="flex justify-center sm:justify-start mb-6">
      <div class="bg-gradient-to-r from-yellow-400 to-amber-500 text-black px-5 py-3 rounded-xl font-semibold shadow-lg text-sm sm:text-base">
        Your DOB: <%= dob%>
      </div>
    </div>

    <!-- Tabs -->
    <div class="tab-scroll flex gap-2 sm:gap-3 border-b border-gray-700 pb-3 overflow-x-auto">
      <button onclick="showTab('events')" class="tab-btn active whitespace-nowrap px-4 py-2 rounded-lg text-sm sm:text-base font-medium bg-purple-600 shadow transition">Events</button>
      <button onclick="showTab('births')" class="tab-btn whitespace-nowrap px-4 py-2 rounded-lg text-sm sm:text-base font-medium bg-gray-700 hover:bg-gray-600 transition">Births</button>
      <button onclick="showTab('deaths')" class="tab-btn whitespace-nowrap px-4 py-2 rounded-lg text-sm sm:text-base font-medium bg-gray-700 hover:bg-gray-600 transition">Deaths</button>
      <button onclick="showTab('holidays')" class="tab-btn whitespace-nowrap px-4 py-2 rounded-lg text-sm sm:text-base font-medium bg-gray-700 hover:bg-gray-600 transition">Holidays</button>
    </div>

    <!-- Events -->
    <div id="events" class="tab-content grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 mt-6">
      <% data.events.forEach((event, i) => { %>
      <div class="card-enter bg-white/10 backdrop-blur-lg p-5 rounded-xl shadow-lg ring-1 ring-white/10 hover:scale-[1.02] hover:ring-purple-400/40 transition transform"
           style="animation-delay: <%= Math.min(i * 40, 400) %>ms">
        <div class="flex items-start justify-between gap-3 mb-2">
          <h3 class="text-lg sm:text-xl font-bold text-purple-300"><%= event.year %></h3>
          <span class="text-xs text-gray-400 shrink-0">Event</span>
        </div>
        <p class="text-gray-200 text-sm sm:text-base leading-relaxed"><%= event.text %></p>
        <% if (event.pages && event.pages[0]) { %>
        <a href="https://en.wikipedia.org/wiki/<%= event.pages[0].normalizedtitle %>" target="_blank" rel="noopener"
          class="inline-flex items-center gap-1 text-purple-400 hover:text-purple-300 hover:underline mt-3 text-sm font-medium">
          Read More <span aria-hidden="true">→</span>
        </a>
        <% } %>
      </div>
      <% }) %>
    </div>

    <!-- Births -->
    <div id="births" class="tab-content hidden grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 mt-6">
      <% data.births.forEach((birth, i) => { %>
      <div class="card-enter bg-white/10 backdrop-blur-lg p-5 rounded-xl shadow-lg ring-1 ring-white/10 hover:scale-[1.02] hover:ring-emerald-400/40 transition transform"
           style="animation-delay: <%= Math.min(i * 40, 400) %>ms">
        <div class="flex items-start justify-between gap-3 mb-2">
          <h3 class="text-lg sm:text-xl font-bold text-emerald-300"><%= birth.year %></h3>
          <span class="text-xs text-gray-400 shrink-0">Birth</span>
        </div>
        <p class="text-gray-200 text-sm sm:text-base leading-relaxed"><%= birth.text %></p>
      </div>
      <% }) %>
    </div>

    <!-- Deaths -->
    <div id="deaths" class="tab-content hidden grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 mt-6">
      <% data.deaths.forEach((death, i) => { %>
      <div class="card-enter bg-white/10 backdrop-blur-lg p-5 rounded-xl shadow-lg ring-1 ring-white/10 hover:scale-[1.02] hover:ring-rose-400/40 transition transform"
           style="animation-delay: <%= Math.min(i * 40, 400) %>ms">
        <div class="flex items-start justify-between gap-3 mb-2">
          <h3 class="text-lg sm:text-xl font-bold text-rose-300"><%= death.year %></h3>
          <span class="text-xs text-gray-400 shrink-0">Death</span>
        </div>
        <p class="text-gray-200 text-sm sm:text-base leading-relaxed"><%= death.text %></p>
      </div>
      <% }) %>
    </div>

    <!-- Holidays -->
    <div id="holidays" class="tab-content hidden grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 mt-6">
      <% data.holidays.forEach((holiday, i) => { %>
      <div class="card-enter bg-white/10 backdrop-blur-lg p-5 rounded-xl shadow-lg ring-1 ring-white/10 hover:scale-[1.02] hover:ring-amber-400/40 transition transform"
           style="animation-delay: <%= Math.min(i * 40, 400) %>ms">
        <div class="flex items-start justify-between gap-3">
          <h3 class="text-base sm:text-lg font-bold text-amber-300"><%= holiday.text %></h3>
          <span class="text-xs text-gray-400 shrink-0">Holiday</span>
        </div>
      </div>
      <% }) %>
    </div>
  </section>

  <!-- Hide loader when data is rendered -->
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      document.getElementById("loader").classList.add("hidden");
    });
  </script>
  <% } %>

  <script>
    function showLoader() {
      document.getElementById("loader").classList.remove("hidden");
    }

    function showTab(tabId) {
      document.querySelectorAll(".tab-content").forEach(el => el.classList.add("hidden"));
      document.querySelector(`#${tabId}`).classList.remove("hidden");
      document.querySelectorAll(".tab-btn").forEach(btn => btn.classList.remove("bg-purple-600", "active"));
      event.target.classList.add("bg-purple-600");
    }
  </script>
</body>
</html>