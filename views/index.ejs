<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Your Day in History</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-gradient-to-br from-indigo-900 via-purple-900 to-black text-white min-h-screen">

  <!-- Loader -->
  <div id="loader" class="fixed inset-0 bg-black/80 flex flex-col items-center justify-center z-50 hidden">
    <div class="w-16 h-16 border-4 border-purple-400 border-t-transparent rounded-full animate-spin"></div>
    <p class="mt-4 text-lg text-gray-300">Fetching...</p>
  </div>

  <!-- Header -->
  <header class="py-8 text-center">
    <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight">📜 Your Day in History</h1>
    <p class="mt-3 text-lg text-gray-300">Discover historical events, famous births, and more from your birthday.</p>
  </header>

  <!-- Form -->
  <section class="max-w-xl mx-auto bg-white/10 backdrop-blur-lg p-6 rounded-2xl shadow-lg">
    <form method="post" action="getData/" class="flex flex-col md:flex-row gap-4" onsubmit="showLoader()">
      <input type="date" name="date" required
        class="w-full px-4 py-3 rounded-lg bg-gray-800 text-white focus:ring-4 focus:ring-purple-500 border border-gray-700" />
      <button type="submit"
        class="px-6 py-3 bg-gradient-to-r from-purple-500 to-indigo-500 rounded-lg font-semibold hover:scale-105 transition transform">
        Show History
      </button>
    </form>
  </section>

  <!-- Results -->
  <% if (data) { %>
    
  <section class="max-w-5xl mx-auto mt-10 px-4">
    <div class="bg-yellow-500 text-black p-7 text-lg inline-block rounded-lg m-3">Your DOB: <%= dob%></div>
    <!-- Tabs -->
    <div class="flex space-x-4 border-b border-gray-700 pb-2 overflow-x-auto">
      <button onclick="showTab('events')" class="tab-btn active px-4 py-2 rounded-lg bg-purple-600">Events</button>
      <button onclick="showTab('births')" class="tab-btn px-4 py-2 rounded-lg bg-gray-700 hover:bg-gray-600">Births</button>
      <button onclick="showTab('deaths')" class="tab-btn px-4 py-2 rounded-lg bg-gray-700 hover:bg-gray-600">Deaths</button>
      <button onclick="showTab('holidays')" class="tab-btn px-4 py-2 rounded-lg bg-gray-700 hover:bg-gray-600">Holidays</button>
    </div>

    <!-- Events -->
    <div id="events" class="tab-content grid sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-6">
      <% data.events.forEach(event => { %>
      <div class="bg-white/10 backdrop-blur-lg p-5 rounded-xl shadow-lg hover:scale-105 transition transform">
        <h3 class="text-xl font-bold mb-2"><%= event.year %></h3>
        <p class="text-gray-300"><%= event.text %></p>
        <% if (event.pages && event.pages[0]) { %>
        <a href="https://en.wikipedia.org/wiki/<%= event.pages[0].normalizedtitle %>" target="_blank"
          class="text-purple-400 hover:underline mt-3 block">Read More →</a>
        <% } %>
      </div>
      <% }) %>
    </div>

    <!-- Births -->
    <div id="births" class="tab-content hidden grid sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-6">
      <% data.births.forEach(birth => { %>
      <div class="bg-white/10 p-5 rounded-xl shadow-lg hover:scale-105 transition transform">
        <h3 class="text-xl font-bold mb-2"><%= birth.year %></h3>
        <p class="text-gray-300"><%= birth.text %></p>
      </div>
      <% }) %>
    </div>

    <!-- Deaths -->
    <div id="deaths" class="tab-content hidden grid sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-6">
      <% data.deaths.forEach(death => { %>
      <div class="bg-white/10 p-5 rounded-xl shadow-lg hover:scale-105 transition transform">
        <h3 class="text-xl font-bold mb-2"><%= death.year %></h3>
        <p class="text-gray-300"><%= death.text %></p>
      </div>
      <% }) %>
    </div>

    <!-- Holidays -->
    <div id="holidays" class="tab-content hidden grid sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-6">
      <% data.holidays.forEach(holiday => { %>
      <div class="bg-white/10 p-5 rounded-xl shadow-lg hover:scale-105 transition transform">
        <h3 class="text-lg font-bold mb-2"><%= holiday.text %></h3>
      </div>
      <% }) %>
    </div>
  </section>

  <!-- Hide loader when data is rendered -->
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      document.getElementById("loader").classList.add("hidden");
    });
  </script>
  <% } %>

  <script>
    function showLoader() {
      document.getElementById("loader").classList.remove("hidden");
    }

    function showTab(tabId) {
      document.querySelectorAll(".tab-content").forEach(el => el.classList.add("hidden"));
      document.querySelector(`#${tabId}`).classList.remove("hidden");
      document.querySelectorAll(".tab-btn").forEach(btn => btn.classList.remove("bg-purple-600", "active"));
      event.target.classList.add("bg-purple-600");
    }
  </script>
</body>
</html>
